BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
MAX_BODY_SIZE=1mb
UPLOAD_MAX_MB=5
